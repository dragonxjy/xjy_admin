{
  "name": "xjy_admin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "preview": "vite preview --host",
    "build": "pnpm type-check && vite build --mode production",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src --ext .ts,.vue --max-warnings 0",
    "fix": "pnpm lint --fix",
    "format": "prettier --write \"**/*.{html,vue,ts,js,json,md,scss,css,yaml}\"",
    "lint:eslint": "pnpm lint",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" \"public/**/*.css\"",
    "lint:style:fix": "pnpm lint:style --fix",
    "check": "pnpm lint && pnpm lint:style && pnpm build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@vueuse/core": "14.4.0",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",
    "animate.css": "4.1.1",
    "axios": "1.20.0",
    "dayjs": "1.11.23",
    "echarts": "5.6.0",
    "element-plus": "2.14.7",
    "lodash": "4.18.1",
    "mockjs": "1.1.0",
    "nprogress": "0.2.0",
    "pinia": "2.3.1",
    "pinia-plugin-persistedstate": "3.2.3",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/lodash": "4.17.26",
    "@types/mockjs": "1.0.10",
    "@types/node": "24.19.2",
    "@types/nprogress": "0.2.3",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-vue": "6.0.10",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "postcss": "8.5.30",
    "postcss-html": "2.0.0",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "sass": "1.105.2",
    "stylelint": "16.26.1",
    "stylelint-config-recess-order": "5.1.1",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "13.1.0",
    "typescript": "5.5.4",
    "unocss": "66.11.0",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "7.3.7",
    "vite-plugin-mock": "3.0.2",
    "vite-plugin-svg-icons": "2.0.1",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.13"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "pnpm": "12.14.0"
  }
}
